      "esx": [
        { "rule": "no-set-prototype-union", "aggressive": false },
        { "rule": "no-set-prototype-intersection", "aggressive": false },
        { "rule": "no-set-prototype-difference", "aggressive": false },
        { "rule": "no-set-prototype-symmetricdifference", "aggressive": true },
        { "rule": "no-set-prototype-issubsetof", "aggressive": true },
        { "rule": "no-set-prototype-issupersetof", "aggressive": true },
        { "rule": "no-set-prototype-isdisjointfrom", "aggressive": true }
