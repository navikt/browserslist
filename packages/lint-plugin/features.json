    "map-getorinsert": {
      "title": "Map/WeakMap.prototype.getOrInsert[Computed]",
      "disposition": "esx",
      "unlowerable": true,
      "bcd": [
        "javascript.builtins.Map.getOrInsert",
        "javascript.builtins.Map.getOrInsertComputed",
        "javascript.builtins.WeakMap.getOrInsert",
        "javascript.builtins.WeakMap.getOrInsertComputed"
      ],
      "esx": [
        { "rule": "no-map-prototype-getorinsert", "aggressive": true },
        { "rule": "no-map-prototype-getorinsertcomputed", "aggressive": true },
        { "rule": "no-weakmap-prototype-getorinsert", "aggressive": true },
        { "rule": "no-weakmap-prototype-getorinsertcomputed", "aggressive": true }
      ],
      "guidance": "Very new (2025 proposal); use `map.get(k) ?? map.set(k, v).get(k)` or a polyfill."
    },
    "set-methods": {
      "title": "Set methods (union, intersection, difference, …)",
