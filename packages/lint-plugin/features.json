{
  "description": "Curated source of truth for the browser-support lint preset. Each feature declares a disposition: 'esx' (below-floor unlowerable builtin/regex feature, enforced via wrapped eslint-plugin-es-x rules), 'compat' (Web API, eslint-plugin-compat's domain; 'compatCoverage' records whether compat actually flags it today), 'syntax' (bundler-lowerable, the config package's concern; kept for level marker tests), or 'safe' (unlowerable but native at/above the floor; generation fails if that stops being true). Per-browser native minima are NOT stored here — scripts/generate.mjs derives them from @mdn/browser-compat-data into data/support.json.",
  "levels": {
    "es": {
      "year": 2021,
      "caveats": [
        "Class static blocks (ES2022) need Safari 16.4; the floor is Safari 16. Bundlers lower them; unbundled code must not use them."
      ]
    },
    "baseline": {
      "year": 2022,
      "approximate": true
    }
  },
  "features": {
