{
  "name": "@navikt/browserslist-config-workspace",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "pnpm -r generate",
    "test": "pnpm -r test",
    "check:publint": "publint packages/config && publint packages/lint-plugin",
    "check:attw": "attw --pack packages/config --profile node16 --ignore-rules cjs-resolves-to-esm && attw --pack packages/lint-plugin --profile node16 --ignore-rules cjs-resolves-to-esm",
    "check": "pnpm check:publint && pnpm check:attw",
    "changeset": "changeset",
    "release": "pnpm changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.1",
    "publint": "0.3.24"
  }
}
